{
  "name": "mingyu",
  "version": "2.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "build:cli": "vite build --config vite.cli.config.ts",
    "build:cli-variant": "node scripts/build-cli-variant.mjs",
    "build:skill": "node scripts/build-skill-package.mjs",
    "deploy": "wrangler deploy",
    "dev:worker": "wrangler dev --local",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:worker-profile": "node scripts/check-worker-profile.mjs",
    "check:mcp-profile": "node scripts/check-mcp-profile.mjs",
    "check:browser-form": "node scripts/check-browser-form.mjs",
    "check:browser-ai": "node scripts/check-browser-ai.mjs",
    "check:clean-build": "node scripts/check-clean-build.mjs",
    "check:all": "node scripts/check-all.mjs",
    "data:character-version": "node scripts/character-version.mjs --write",
    "data:static-version": "node scripts/static-data-version.mjs --write",
    "mcp": "node dist-mcp/server.mjs",
    "qizheng-range": "node --import tsx scripts/qizheng-range.ts",
    "astrolabe-range": "node --import tsx scripts/astrolabe-range.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-switch": "^1.4.1",
    "astronomy-engine": "2.1.19",
    "caelus": "0.24.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tyme4ts": "1.5.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "24.13.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.5",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "wrangler": "4.162.0"
  }
}
