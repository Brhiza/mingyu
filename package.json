{
  "name": "mingyu",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm --filter mingyu-core build && vite build",
    "preview": "vite preview",
    "test": "pnpm --filter mingyu-core build && tsx --tsconfig tsconfig.app.json --test \"tests/*.test.ts\"",
    "test:core": "pnpm --filter mingyu-core test",
    "test:api": "pnpm --filter mingyu-core build && tsx --tsconfig tsconfig.app.json --test tests/public-api.test.ts tests/public-api-docs.test.ts tests/node-request-body.test.ts",
    "test:prompt": "pnpm --filter mingyu-core build && tsx --tsconfig tsconfig.app.json --test tests/prompt-evidence.test.ts tests/fortune-selection.test.ts tests/bazi-ai-prompt.test.ts tests/ziwei-prompt-snapshot.test.ts tests/astrolabe-scope.test.ts tests/divination-prompt-structure.test.ts tests/divination-engine.test.ts",
    "test:mcp": "pnpm --filter mingyu-core build && pnpm test:e2e",
    "test:e2e": "tsx --tsconfig tsconfig.app.json --test --test-concurrency=1 \"tests/mcp/*.test.ts\"",
    "test:browser-contract": "pnpm --filter mingyu-core build && node scripts/test-browser-contracts.mjs",
    "package:check": "pnpm --filter mingyu-core build && node scripts/test-package-tarballs.mjs",
    "lint": "eslint src packages/core/src --max-warnings 999",
    "lint:fix": "eslint src packages/core/src --fix --max-warnings 999",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"packages/core/src/**/*.ts\" \"packages/core/scripts/**/*.mjs\" \"tests/**/*.ts\" \"build/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"packages/core/src/**/*.ts\" \"packages/core/scripts/**/*.mjs\" \"tests/**/*.ts\" \"build/**/*.ts\"",
    "prompt:check": "pnpm test:prompt && pnpm prompt:audit",
    "prompt:audit": "tsx --tsconfig tsconfig.app.json scripts/generate-prompt-audit.ts",
    "contest:evaluate": "node scripts/evaluate-fortune-contest-model.js",
    "mcp": "tsx --tsconfig mcp/tsconfig.json mcp/src/server.ts",
    "core:build": "pnpm --filter mingyu-core build",
    "core:test": "pnpm test:core"
  },
  "dependencies": {
    "celestine": "^0.2.1",
    "iztro": "^2.5.8",
    "marked": "^16.4.2",
    "mingyu-core": "workspace:*",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "tyme4ts": "^1.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.7",
    "webpack": "5.101.3",
    "webpack-cli": "6.0.1",
    "zod": "^4.4.3"
  }
}
