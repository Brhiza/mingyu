# AI 解析功能环境变量
# 复制此文件为 .dev.vars 后填入真实值
# Cloudflare Pages 部署时在 Dashboard → Settings → Environment variables 中配置同样的变量
#
# 注意：仅配置 AI_API_KEY 不会自动显示前端内置 AI。
# 需要显式设置 AI_BUILTIN_ENABLED=true，才显示并允许使用服务端 AI。
# AI_DEFAULT_ENABLED 只控制页面是否默认进入 AI 解读；公益服务不稳定时建议保持 false。

# API Key（填写你的 AI 服务商密钥）
# 支持任何 OpenAI 兼容接口，如 DeepSeek、千问、豆包、Groq、OpenAI 等
AI_API_KEY=your-api-key

# 接口地址（保持 /v1 结尾，默认 https://api.deepseek.com/v1）
AI_BASE_URL=https://api.deepseek.com/v1

# 模型名称（默认 deepseek-chat，可按服务商修改，如 gpt-4o-mini、qwen-turbo 等）
AI_MODEL=deepseek-chat

# 前端显示的服务端 AI 名称（可选）
# AI_PROVIDER_NAME=DeepSeek

# 是否显示并允许使用内置 AI（可选，默认 false）
# AI_BUILTIN_ENABLED=true

# 页面是否默认打开 AI 解读（可选，默认 false）
# AI_DEFAULT_ENABLED=false

# ── 隐私友好分析（可选，默认关闭）──
# 仅当显式配置 ANALYTICS_PROVIDER 时启用；合规铁律：默认不采集。
# provider 取值：plausible | umami | ga（留空或 none 则关闭）
# ANALYTICS_PROVIDER=plausible
# Plausible：ANALYTICS_URL=https://plausible.io/js/script.js ANALYTICS_SITE_ID=your-domain.com
# Umami：  ANALYTICS_URL=https://umami.your-domain.com/script.js ANALYTICS_SITE_ID=your-website-id
# GA：     ANALYTICS_SITE_ID=G-XXXXXXXXXX

# ── 账户认证（可选，CF KV + 边缘函数）──
# 需在 Cloudflare Pages → Functions → KV 命名空间绑定 AUTH_KV，并配置 AUTH_SECRET。
# 本地 vite dev 不执行 functions/api/auth/*，认证端点返回 503（客户端优雅降级）。
# AUTH_ENABLED=true
# AUTH_SECRET=请生成强随机密钥（如 openssl rand -hex 32）
# 同时在 Cloudflare 控制台创建 KV 命名空间并命名为 AUTH_KV 后绑定到本 Pages 项目。
