# AI 解析功能环境变量（本地开发与 Cloudflare Pages 部署共用）
# 注意：本文件已被 .gitignore 忽略，密钥不会提交到仓库。

# API Key（AI 服务商密钥，支持任何 OpenAI 兼容接口，如 DeepSeek、千问、豆包、Groq、OpenAI 等）
AI_API_KEY=sk-0a697b11d772475185671f3d8c50bd99

# 接口地址（OpenAI 兼容接口，默认 https://api.deepseek.com）
AI_BASE_URL=https://api.deepseek.com

# 模型名称（DeepSeek 支持 deepseek-v4-pro / deepseek-v4-flash）
AI_MODEL=deepseek-v4-pro

# 页面是否默认进入 AI 解读（true 为默认打开 AI 解读，false 为默认提示词模式）
AI_DEFAULT_ENABLED=true

# 是否启用服务端内置 AI（true 才允许前端使用服务端配置的模型）
AI_BUILTIN_ENABLED=true

# 前端展示的 AI 名称
AI_PROVIDER_NAME=玄综师傅
