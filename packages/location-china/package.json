{
  "name": "mingyu-location-china",
  "version": "0.1.0",
  "description": "中国省市区出生地点树与经度索引，配合 mingyu-core 使用",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc --build tsconfig.json --force && node scripts/generate-data.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "mingyu-core": "workspace:^"
  },
  "keywords": [
    "china",
    "location",
    "birth-place",
    "longitude",
    "中国省市区",
    "出生地",
    "真太阳时"
  ],
  "author": "Brhiza",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Brhiza/mingyu.git",
    "directory": "packages/location-china"
  },
  "bugs": {
    "url": "https://github.com/Brhiza/mingyu/issues"
  },
  "homepage": "https://github.com/Brhiza/mingyu/tree/main/packages/location-china#readme",
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
