{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/bazi/baziTherapeuticRules.ts",
    "src/bazi/baziTherapeuticRules/**/*.ts",
    "src/bazi/baziUsefulGodRules.ts",
    "src/bazi/baziShenSha/helpers/tenGodAnalysis.ts",
    "src/bazi/usefulGodPlacement.ts",
    "src/divination/algorithms/_shared/**/*.ts",
    "src/divination/ssgw-data/interpretation.ts",
    "src/divination/ssgw-data/signs-01.ts",
    "src/divination/ssgw-data/signs-02.ts",
    "src/divination/ssgw-data/signs-03.ts",
    "src/divination/ssgw-data/signs-full.ts"
  ]
}
